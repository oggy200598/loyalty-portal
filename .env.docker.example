# Use a fresh database volume for this Docker Compose environment.
# Review SQL Server container license before setting Y and starting the container.
ACCEPT_EULA=
# SQL Server requires a strong password with upper/lower case, numbers and symbols.
SQLSERVER_PASSWORD=
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional VNPay sandbox merchant credentials. Leave blank to keep online payment disabled.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay/return

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:3000/payments/momo/return
MOMO_IPN_URL=
