        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor White\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 13\nskinparam maxMessageSize 235\nskinparam sequenceMessageAlign center\nskinparam sequence {\n  ArrowColor #B00040\n  LifeLineBorderColor #B00040\n  LifeLineBackgroundColor #FFFFFF\n  ParticipantBackgroundColor #FFFFCC\n  ParticipantBorderColor #B00040\n  ActorBorderColor #B00040\n  ActorFontColor #000000\n  GroupBorderColor #555555\n  GroupBackgroundColor #FFFFFF\n  ActivationBackgroundColor #FFFFFF\n  ActivationBorderColor #B00040\n}\nhide footbox\n&lt;style&gt;\nsequenceDiagram {\n  participant,actor,boundary,control,entity {\n    BackgroundColor #FFFFCC\n    LineColor #B00040\n  }\n}\n&lt;/style&gt;\ntitle UC04 – Gửi và theo dõi khiếu nại\nactor \&quot;&lt;u&gt;: Khách hàng&lt;/u&gt;\&quot; as A\nboundary \&quot;&lt;u&gt;: FrmKhieuNai&lt;/u&gt;\&quot; as UI\ncontrol \&quot;&lt;u&gt;: LoyaltyService&lt;/u&gt;\&quot; as S\nentity \&quot;&lt;u&gt;: ThanhVien&lt;/u&gt;\&quot; as TV\nentity \&quot;&lt;u&gt;: DonHang&lt;/u&gt;\&quot; as DH\nentity \&quot;&lt;u&gt;: KhieuNai&lt;/u&gt;\&quot; as KN\n\nA -&gt; UI : Nhập loại, nội dung khiếu nại, mã đơn nếu có\nactivate UI\nUI -&gt; S : GuiKhieuNai(maThanhVien, loai, noiDung, maDonHang?)\nactivate S\nS -&gt; TV ++ : KiemTraHoSo(maThanhVien)\nTV --&gt; S -- : Kết quả kiểm tra\nopt Có mã đơn tham chiếu\n  S -&gt; DH ++ : KiemTraDonThuocKhachHang(maDonHang, maThanhVien)\n  DH --&gt; S -- : Kết quả đối chiếu\nend\nS -&gt; S : Kiểm tra nội dung và thông tin liên quan\nalt Dữ liệu không hợp lệ\n  S --&gt; UI : KetQuaXuLy.Fail(lyDo)\nelse Hợp lệ – trong một transaction\n  S -&gt; KN ++ : TaoKhieuNai(maThanhVien, loai, noiDung, maDonHang, OPEN)\n  KN --&gt; S -- : Khiếu nại mới\n  S -&gt; S : Ghi nhật ký, Commit()\n  S --&gt; UI : KetQuaXuLy.Ok(maKhieuNai, trangThai)\nend\ndeactivate S\nUI --&gt; A : Thông báo kết quả gửi\nopt Xem hoặc lọc khiếu nại cá nhân\n  A -&gt; UI : Chọn trạng thái, ngày, nội dung và trang\n  UI -&gt; S : TraCuuKhieuNai(maThanhVien, dieuKienLoc, trang)\n  activate S\n  S -&gt; KN ++ : LayDanhSachCuaThanhVien(maThanhVien, dieuKienLoc, trang)\n  KN --&gt; S -- : Nội dung, trạng thái, phản hồi và tổng số\n  S --&gt; UI : Danh sách phân trang\n  deactivate S\n  UI --&gt; A : Hiển thị trạng thái và kết quả giải quyết\nend\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8UHoKluhAEbvJUR8MhlL-148">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
