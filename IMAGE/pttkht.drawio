        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC5: Biểu đồ tuần tự Quản lý hạng thành viên\n\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam roundcorner 0\nskinparam sequenceMessageAlign center\n\nparticipant \&quot;Khách hàng\&quot; as KH\nparticipant \&quot;Giao diện\&quot; as GD\nparticipant \&quot;Hệ thống\&quot; as HT\ndatabase \&quot;Cơ sở dữ liệu\&quot; as CSDL\n\nKH -&gt; GD : Xem hạng thành viên\nactivate GD\n\nGD -&gt; HT : Yêu cầu thông tin hạng\nactivate HT\n\nHT -&gt; CSDL : Lấy thông tin điểm\nactivate CSDL\nCSDL --&gt; HT : Thông tin điểm\ndeactivate CSDL\n\nHT -&gt; CSDL : Lấy thông tin hạng\nactivate CSDL\nCSDL --&gt; HT : Thông tin hạng\ndeactivate CSDL\n\nHT -&gt; HT : Kiểm tra điều kiện hạng\n\nalt Đủ điều kiện nâng hạng\n    HT -&gt; CSDL : Cập nhật hạng thành viên\n    activate CSDL\n    CSDL --&gt; HT : Cập nhật thành công\n    deactivate CSDL\n\n    HT -&gt; CSDL : Cập nhật quyền lợi\n    activate CSDL\n    CSDL --&gt; HT : Cập nhật thành công\n    deactivate CSDL\n\n    HT --&gt; GD : Hạng mới và quyền lợi\n\nelse Chưa đủ điều kiện\n    HT --&gt; GD : Hạng hiện tại và quyền lợi\nend\n\ndeactivate HT\n\nGD --&gt; KH : Hiển thị thông tin hạng\ndeactivate GD\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiG1z5pY0S9EBoXZtEyz-1812">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
