        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor White\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 13\nskinparam maxMessageSize 235\nskinparam sequenceMessageAlign center\nskinparam sequence {\n  ArrowColor #B00040\n  LifeLineBorderColor #B00040\n  LifeLineBackgroundColor #FFFFFF\n  ParticipantBackgroundColor #FFFFCC\n  ParticipantBorderColor #B00040\n  ActorBorderColor #B00040\n  ActorFontColor #000000\n  GroupBorderColor #555555\n  GroupBackgroundColor #FFFFFF\n  ActivationBackgroundColor #FFFFFF\n  ActivationBorderColor #B00040\n}\nhide footbox\n&lt;style&gt;\nsequenceDiagram {\n  participant,actor,boundary,control,entity {\n    BackgroundColor #FFFFCC\n    LineColor #B00040\n  }\n}\n&lt;/style&gt;\ntitle UC05 – Quản lý thành viên và điều chỉnh điểm\nactor \&quot;&lt;u&gt;: Quản trị viên&lt;/u&gt;\&quot; as A\nboundary \&quot;&lt;u&gt;: FrmQuanLyThanhVien&lt;/u&gt;\&quot; as UI\ncontrol \&quot;&lt;u&gt;: LoyaltyService&lt;/u&gt;\&quot; as S\nentity \&quot;&lt;u&gt;: ThanhVien&lt;/u&gt;\&quot; as TV\nentity \&quot;&lt;u&gt;: DieuChinhDiem&lt;/u&gt;\&quot; as DC\nentity \&quot;&lt;u&gt;: GiaoDichDiem&lt;/u&gt;\&quot; as GD\nentity \&quot;&lt;u&gt;: NhatKyHoatDong&lt;/u&gt;\&quot; as NK\n\nA -&gt; UI : Mở danh sách, nhập điều kiện tìm thành viên\nactivate UI\nUI -&gt; S : TraCuuThanhVien(tuKhoa, hang, trangThai, trang)\nS -&gt; TV ++ : LayDanhSach(dieuKienLoc, trang)\nTV --&gt; S -- : Danh sách thành viên và tổng số\nS --&gt; UI : Danh sách phân trang\nA -&gt; UI : Chọn thành viên, nhập điểm và lý do, xác nhận\nUI -&gt; S : DieuChinhDiem(maThanhVien, soDiem, lyDo, maYeuCau, apDungNgay)\nactivate S\nS -&gt; S : Bắt đầu transaction, kiểm tra quyền và dữ liệu\nS -&gt; DC ++ : KhoaVaTimTheoMaYeuCau(maYeuCau)\nDC --&gt; S -- : Yêu cầu cũ / chưa có\nalt Yêu cầu đã xử lý cùng nội dung\n  S -&gt; S : Commit(), không cập nhật điểm lần hai\n  S --&gt; UI : KetQuaXuLy.Ok(ketQuaCu)\nelse Dữ liệu sai hoặc mã yêu cầu dùng cho nội dung khác\n  S -&gt; S : Rollback()\n  S --&gt; UI : KetQuaXuLy.Fail(lyDo)\nelse Yêu cầu mới hợp lệ\n  S -&gt; DC ++ : TaoDieuChinh(maThanhVien, soDiem, lyDo, PENDING)\n  DC --&gt; S -- : Yêu cầu mới\n  alt Áp dụng ngay\n    S -&gt; TV ++ : KhoaVaKiemTraSoDuSauDieuChinh(soDiem)\n    TV --&gt; S -- : Kết quả kiểm tra\n    alt Đủ điều kiện\n      S -&gt; GD ++ : GhiNhanDieuChinh(maThanhVien, soDiem, maDieuChinh)\n      GD --&gt; S -- : Giao dịch điểm\n      S -&gt; TV ++ : CapNhatSoDuVaKhoanDiem(soDiem)\n      TV --&gt; S -- : Số dư mới\n      S -&gt; DC ++ : GhiQuyetDinh(APPROVED, nguoiXacNhan, lyDo)\n      DC --&gt; S -- : Điều chỉnh đã áp dụng\n      S -&gt; NK ++ : GhiNhanDieuChinh(duLieuTruoc, duLieuSau)\n      NK --&gt; S -- : Đã ghi nhật ký\n      S -&gt; S : Commit()\n      S --&gt; UI : KetQuaXuLy.Ok(soDuMoi)\n    else Không đủ điểm hoặc lỗi cập nhật\n      S -&gt; S : Rollback() toàn bộ yêu cầu mới\n      S --&gt; UI : KetQuaXuLy.Fail(lyDo)\n    end\n  else Lưu chờ duyệt\n    S -&gt; NK ++ : GhiNhanYeuCauChoDuyet(maDieuChinh)\n    NK --&gt; S -- : Đã ghi\n    S -&gt; S : Commit(), chưa thay đổi số dư\n    S --&gt; UI : KetQuaXuLy.Ok(PENDING)\n  end\nend\ndeactivate S\nopt Quản trị viên xử lý yêu cầu PENDING\n  A -&gt; UI : Chọn duyệt/từ chối và nhập lý do\n  UI -&gt; S : XuLyDieuChinh(maDieuChinh, quyetDinh, lyDo)\n  activate S\n  S -&gt; DC ++ : KhoaVaKiemTraTrangThai(maDieuChinh)\n  DC --&gt; S -- : Trạng thái hiện tại\n  alt Đã xử lý\n    S --&gt; UI : KetQuaXuLy.Fail(\&quot;Yêu cầu đã được xử lý\&quot;)\n  else Còn PENDING\n    opt Quyết định phê duyệt\n      ref over S,NK : Kiểm tra số dư và cập nhật điểm trong transaction\\nnhư nhánh áp dụng ngay ở trên\n    end\n    S -&gt; DC ++ : GhiQuyetDinh(quyetDinh, nguoiXuLy, lyDo)\n    DC --&gt; S -- : Kết quả\n    S -&gt; NK ++ : GhiNhanQuyetDinh(maDieuChinh)\n    NK --&gt; S -- : Đã ghi\n    S -&gt; S : Commit() nếu toàn bộ thao tác thành công\n    S --&gt; UI : KetQuaXuLy.Ok(trangThai)\n  end\n  deactivate S\nend\nUI --&gt; A : Hiển thị kết quả và số dư\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8UHoKluhAEbvJUR8MhlL-207">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
