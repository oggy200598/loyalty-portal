        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC01 – Đăng ký, đăng nhập\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam defaultFontName Arial\nskinparam activityBackgroundColor #DAE8FC\nskinparam activityBorderColor #6C8EBF\n|Người dùng|\nstart\nif (Đăng ký tài khoản mới?) then (Có)\n  :Nhập thông tin đăng ký khách hàng;\n  |Hệ thống|\n  :Kiểm tra dữ liệu, tài khoản trùng\nvà vai trò BUYER;\n  if (Hợp lệ?) then (Có)\n    :Băm mật khẩu;\n    :Trong cùng transaction:\ntạo tài khoản và hồ sơ thành viên;\n    if (Có chính sách hiệu lực và lưu thành công?) then (Có)\n      :Cấp phiên truy cập khách hàng;\n    else (Không)\n      :Hoàn tác và thông báo lỗi;\n      stop\n    endif\n  else (Không)\n    :Thông báo nguyên nhân;\n    stop\n  endif\nelse (Không)\n  :Nhập tài khoản và mật khẩu;\n  |Hệ thống|\n  :Kiểm tra thông tin, mật khẩu\nvà trạng thái ACTIVE;\n  if (Xác thực thành công?) then (Có)\n    :Cấp phiên truy cập theo vai trò;\n  else (Không)\n    :Từ chối đăng nhập;\n    stop\n  endif\nendif\n:Hiển thị trang phù hợp với vai trò;\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VbHyYETtyQtT7RWVlfbA-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
