        <UserObject label="Quản lý và công bố phiên bản chính sách" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="Quản lý và công bố phiên bản chính sách" id="VbHyYETtyQtT7RWVlfbA-477">
          <mxCell parent="VbHyYETtyQtT7RWVlfbA-416" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="311" x="559.25" y="27940" as="geometry" />
