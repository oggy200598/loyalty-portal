        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nhide circle\nhide methods\nhide stereotypes\n\nskinparam backgroundColor White\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 12\nskinparam classAttributeIconSize 0\n\nskinparam linetype ortho\nskinparam nodesep 55\nskinparam ranksep 85\n\nskinparam class {\n    BackgroundColor White\n    BorderColor Black\n    FontColor Black\n    FontSize 12\n    HeaderBackgroundColor White\n    AttributeFontColor Black\n    StereotypeFontColor Black\n}\n\nskinparam ArrowColor Black\nskinparam ArrowThickness 1\nskinparam packageStyle rectangle\n\ntitle ERD PHÂN HỆ KHÁCH HÀNG THÂN THIẾT VÀ DỮ LIỆU DÙNG CHUNG\n\nentity \&quot;users\&quot; as users {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : uniqueidentifier\n  &lt;b&gt;UQ&lt;/b&gt; email : nvarchar(255)\n  full_name : nvarchar(255) NULL\n  phone : nvarchar(20) NULL\n  status : nvarchar(40)\n}\n\nentity \&quot;orders\&quot; as orders {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;UQ&lt;/b&gt; order_code : nvarchar(50)\n  &lt;b&gt;FK&lt;/b&gt; buyer_id : uniqueidentifier\n  subtotal : decimal(15,2)\n  discount_amount : decimal(15,2)\n  total_amount : decimal(15,2)\n  status : nvarchar(40)\n  payment_status : nvarchar(40)\n  created_at : datetime2(7)\n}\n\nentity \&quot;coupons\&quot; as coupons {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;UQ&lt;/b&gt; code : nvarchar(50)\n  name : nvarchar(255)\n  discount_type : nvarchar(40)\n  discount_value : decimal(15,2)\n  min_order_value : decimal(15,2)\n  usage_limit : int NULL\n  used_count : int\n  start_at : datetime2(7)\n  end_at : datetime2(7)\n  status : nvarchar(40)\n  &lt;b&gt;REF&lt;/b&gt; loyalty_owner_id : uniqueidentifier NULL\n}\n\nentity \&quot;coupon_redemptions\&quot; as coupon_redemptions {\n  &lt;b&gt;PK,REF&lt;/b&gt; &lt;u&gt;order_id&lt;/u&gt; : bigint\n  &lt;b&gt;REF&lt;/b&gt; coupon_id : bigint\n  &lt;b&gt;REF&lt;/b&gt; buyer_id : uniqueidentifier\n  coupon_code : nvarchar(50)\n  discount_amount : decimal(15,2)\n  created_at : datetime2(7)\n}\n\nentity \&quot;audit_logs\&quot; as audit_logs {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;FK&lt;/b&gt; user_id : uniqueidentifier NULL\n  action : nvarchar(100)\n  entity_type : nvarchar(100)\n  entity_id : bigint NULL\n  old_data : nvarchar(max) NULL\n  new_data : nvarchar(max) NULL\n  created_at : datetime2(7)\n}\n\nentity \&quot;loyalty_members\&quot; as loyalty_members {\n  &lt;b&gt;PK,FK&lt;/b&gt; &lt;u&gt;user_id&lt;/u&gt; : uniqueidentifier\n  balance : int\n  qualifying_spend : decimal(15,2)\n  tier_code : nvarchar(30)\n  cycle_started_at : datetime2(7)\n  joined_at : datetime2(7)\n}\n\nentity \&quot;loyalty_rule_versions\&quot; as loyalty_rule_versions {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  name : nvarchar(150)\n  status : nvarchar(20)\n  config : nvarchar(max)\n  &lt;b&gt;UQ&lt;/b&gt; effective_at : datetime2(7) NULL\n  &lt;b&gt;REF&lt;/b&gt; created_by : uniqueidentifier NULL\n  &lt;b&gt;REF&lt;/b&gt; published_by : uniqueidentifier NULL\n  created_at : datetime2(7)\n  published_at : datetime2(7) NULL\n}\n\nentity \&quot;loyalty_point_transactions\&quot; as loyalty_point_transactions {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;FK&lt;/b&gt; member_id : uniqueidentifier\n  kind : nvarchar(20)\n  points : int\n  qualifying_amount : decimal(15,2)\n  &lt;b&gt;UQ&lt;/b&gt; source_key : nvarchar(150)\n  &lt;b&gt;REF&lt;/b&gt; order_id : bigint NULL\n  &lt;b&gt;FK&lt;/b&gt; rule_version_id : bigint NULL\n  description : nvarchar(500)\n  created_at : datetime2(7)\n}\n\nentity \&quot;loyalty_point_lots\&quot; as loyalty_point_lots {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;FK,UQ&lt;/b&gt; transaction_id : bigint\n  &lt;b&gt;REF&lt;/b&gt; member_id : uniqueidentifier\n  remaining : int\n  expires_at : datetime2(7)\n}\n\nentity \&quot;loyalty_rewards\&quot; as loyalty_rewards {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  name : nvarchar(150)\n  description : nvarchar(max) NULL\n  points_cost : int\n  discount_value : decimal(15,2)\n  min_order_value : decimal(15,2)\n  minimum_tier_spend : decimal(15,2)\n  stock : int\n  voucher_days : int\n  active : bit\n  &lt;b&gt;REF&lt;/b&gt; created_by : uniqueidentifier\n  created_at : datetime2(7)\n}\n\nentity \&quot;loyalty_redemptions\&quot; as loyalty_redemptions {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;FK&lt;/b&gt; member_id : uniqueidentifier\n  &lt;b&gt;FK&lt;/b&gt; reward_id : bigint\n  &lt;b&gt;REF,UQ&lt;/b&gt; coupon_id : bigint\n  &lt;b&gt;UQ&lt;/b&gt; coupon_code : nvarchar(50)\n  points_spent : int\n  request_key : uniqueidentifier\n  expires_at : datetime2(7)\n  created_at : datetime2(7)\n}\n\nentity \&quot;loyalty_adjustments\&quot; as loyalty_adjustments {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;FK&lt;/b&gt; member_id : uniqueidentifier\n  &lt;b&gt;FK&lt;/b&gt; complaint_id : bigint NULL\n  points : int\n  reason : nvarchar(max)\n  status : nvarchar(20)\n  &lt;b&gt;REF&lt;/b&gt; requested_by : uniqueidentifier\n  &lt;b&gt;REF&lt;/b&gt; decided_by : uniqueidentifier NULL\n  decision_note : nvarchar(max) NULL\n  created_at : datetime2(7)\n  decided_at : datetime2(7) NULL\n  &lt;b&gt;UQ&lt;/b&gt; request_key : uniqueidentifier NULL\n}\n\nentity \&quot;loyalty_complaints\&quot; as loyalty_complaints {\n  &lt;b&gt;PK&lt;/b&gt; &lt;u&gt;id&lt;/u&gt; : bigint\n  &lt;b&gt;FK&lt;/b&gt; member_id : uniqueidentifier\n  &lt;b&gt;REF&lt;/b&gt; order_id : bigint NULL\n  type : nvarchar(30)\n  message : nvarchar(max)\n  status : nvarchar(20)\n  response : nvarchar(max) NULL\n  &lt;b&gt;REF&lt;/b&gt; handled_by : uniqueidentifier NULL\n  created_at : datetime2(7)\n  updated_at : datetime2(7)\n}\n\nusers ||--o| loyalty_members : user_id\nusers ||--o{ orders : buyer_id\nusers |o--o{ audit_logs : user_id\n\nloyalty_members ||--o{ loyalty_point_transactions : member_id\nloyalty_members ||--o{ loyalty_redemptions : member_id\nloyalty_members ||--o{ loyalty_adjustments : member_id\nloyalty_members ||--o{ loyalty_complaints : member_id\n\nloyalty_rule_versions |o--o{ loyalty_point_transactions : rule_version_id\n\nloyalty_point_transactions ||--o| loyalty_point_lots : transaction_id\n\nloyalty_rewards ||--o{ loyalty_redemptions : reward_id\n\nloyalty_complaints |o--o{ loyalty_adjustments : complaint_id\n\norders ||..o| coupon_redemptions : order_id\norders |o..o{ loyalty_point_transactions : order_id\norders |o..o{ loyalty_complaints : order_id\n\ncoupons ||..o| loyalty_redemptions : coupon_id\ncoupons ||..o{ coupon_redemptions : coupon_id\n\nusers |o..o{ coupons : loyalty_owner_id\nusers ||..o{ coupon_redemptions : buyer_id\n\nloyalty_members ||..o{ loyalty_point_lots : member_id\n\nlegend bottom\n  PK : Khóa chính (gạch chân)\n  FK : Khóa ngoại thực tế\n  UQ : Ràng buộc duy nhất\n  REF : Tham chiếu nghiệp vụ\n  NULL : Cho phép giá trị rỗng\n\n  Đường liền : Quan hệ khóa ngoại trong SQL Server\n  Đường đứt : Quan hệ tham chiếu nghiệp vụ\n\n  || : Một và chỉ một\n  |o : Không hoặc một\n  o{ : Không hoặc nhiều\n  |{ : Một hoặc nhiều\nendlegend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8UHoKluhAEbvJUR8MhlL-612">
