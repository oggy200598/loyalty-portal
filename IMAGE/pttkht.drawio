        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor White\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 13\nskinparam maxMessageSize 235\nskinparam sequenceMessageAlign center\nskinparam sequence {\n  ArrowColor #B00040\n  LifeLineBorderColor #B00040\n  LifeLineBackgroundColor #FFFFFF\n  ParticipantBackgroundColor #FFFFCC\n  ParticipantBorderColor #B00040\n  ActorBorderColor #B00040\n  ActorFontColor #000000\n  GroupBorderColor #555555\n  GroupBackgroundColor #FFFFFF\n  ActivationBackgroundColor #FFFFFF\n  ActivationBorderColor #B00040\n}\nhide footbox\n&lt;style&gt;\nsequenceDiagram {\n  participant,actor,boundary,control,entity {\n    BackgroundColor #FFFFCC\n    LineColor #B00040\n  }\n}\n&lt;/style&gt;\ntitle UC03b – Sử dụng phiếu ưu đãi\nactor \&quot;&lt;u&gt;: Khách hàng&lt;/u&gt;\&quot; as A\nboundary \&quot;&lt;u&gt;: FrmThanhToan&lt;/u&gt;\&quot; as UI\ncontrol \&quot;&lt;u&gt;: CheckoutService&lt;/u&gt;\&quot; as S\nentity \&quot;&lt;u&gt;: PhieuUuDai&lt;/u&gt;\&quot; as P\nentity \&quot;&lt;u&gt;: DonHang&lt;/u&gt;\&quot; as DH\nentity \&quot;&lt;u&gt;: LuotSuDungUuDai&lt;/u&gt;\&quot; as SD\n\nA -&gt; UI : Chọn hoặc nhập mã phiếu ưu đãi\nactivate UI\nUI -&gt; S : TinhBaoGia(maKhachHang, gioHang, maPhieu)\nactivate S\nS -&gt; P ++ : LayThongTin(maPhieu)\nP --&gt; S -- : Chủ sở hữu, hiệu lực, số lượt và điều kiện\nS -&gt; S : Kiểm tra phiếu và tính giá sau ưu đãi\nalt Phiếu không hợp lệ\n  S --&gt; UI : KetQuaXuLy.Fail(lyDo)\nelse Phiếu hợp lệ\n  S --&gt; UI : BaoGia(tongTien, giaTriGiam)\nend\ndeactivate S\nopt Khách hàng xác nhận đặt hàng theo báo giá hợp lệ\n  A -&gt; UI : Xác nhận đặt hàng\n  UI -&gt; S : DatHang(maKhachHang, gioHang, maPhieu, tongTienDuKien)\n  activate S\n  S -&gt; S : Bắt đầu transaction, tính lại giá và điều kiện\n  S -&gt; P ++ : KiemTraVaGhiNhanLuotDung(soLuotDaDoc)\n  P --&gt; S -- : Kết quả kiểm tra cạnh tranh\n  alt Phiếu hết hiệu lực, lượt dùng/giá/tồn kho thay đổi\n    S -&gt; S : Rollback()\n    S --&gt; UI : KetQuaXuLy.Fail(\&quot;Cần cập nhật báo giá\&quot;)\n  else Hợp lệ – trong cùng một transaction\n    loop Mỗi nhóm sản phẩm theo cửa hàng\n      S -&gt; DH ++ : TaoDonHang(thongTinNguoiNhan, sanPham, giaSauUuDai)\n      DH --&gt; S -- : Đơn hàng mới\n      opt Đơn được áp dụng phiếu\n        S -&gt; SD ++ : GhiNhanSuDung(maDonHang, maPhieu, maKhachHang, giaTriGiam)\n        SD --&gt; S -- : Lượt sử dụng ưu đãi\n      end\n    end\n    S -&gt; S : Commit()\n    S --&gt; UI : KetQuaXuLy.Ok(cacDonHang)\n  end\n  deactivate S\nend\nUI --&gt; A : Hiển thị kết quả đặt hàng\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8UHoKluhAEbvJUR8MhlL-76">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
