        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Admin\&quot; as AD\n\nrectangle \&quot;UC5: Quản lý hạng thành viên\&quot; {\n    usecase \&quot;Xem hạng thành viên\&quot; as UC_XemHang\n    usecase \&quot;Cập nhật hạng thành viên\&quot; as UC_CapNhat\n    usecase \&quot;Thiết lập hạng thành viên\&quot; as UC_ThietLap\n    usecase \&quot;Xem danh sách thành viên\&quot; as UC_XemDanhSach\n    usecase \&quot;Kiểm tra điều kiện hạng\&quot; as UC_KiemTra\n}\n\n&#39; Nối Actor với các Use Case\nKH -- UC_XemHang\n\nNV -- UC_CapNhat\nNV -- UC_XemDanhSach\n\nAD -- UC_ThietLap\nAD -- UC_CapNhat\nAD -- UC_XemDanhSach\n\n&#39; Các mối quan hệ Include\nUC_XemHang ..&gt; UC_KiemTra : &lt;&lt;include&gt;&gt;\nUC_CapNhat ..&gt; UC_KiemTra : &lt;&lt;include&gt;&gt;\n\n&#39; Mối quan hệ giữa các Use Case (trong hình gốc vẽ nét liền, có vẻ sai logic UML, nhưng tôi giữ lại nét đứt để thể hiện sự phụ thuộc/gọi đến nhau nếu có)\nUC_ThietLap ..&gt; UC_CapNhat : &lt;&lt;extend&gt;&gt; \n&#39; Lưu ý: Đường mũi tên từ Thiết lập lên Cập nhật trong hình gốc là nét liền. Trong Use Case diagram không nên dùng nét liền giữa 2 use case, nên tôi đề xuất đổi thành &lt;&lt;extend&gt;&gt; hoặc &lt;&lt;include&gt;&gt; tùy logic nghiệp vụ thực tế của bạn.\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiG1z5pY0S9EBoXZtEyz-328">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
