        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam usecaseBackgroundColor #DAE8FC\n\nactor \&quot;Khách hàng\&quot; as KH\n\nrectangle \&quot;UC02 – TRA CỨU THÔNG TIN THÀNH VIÊN VÀ LỊCH SỬ ĐIỂM\&quot; {\n    usecase \&quot;Xem thông tin thành viên\&quot; as TV\n    usecase \&quot;Lấy số dư điểm khả dụng\&quot; as SD\n    usecase \&quot;Lấy hạng và quyền lợi\&quot; as HANG\n    usecase \&quot;Xác định tiến độ lên hạng\&quot; as TD\n\n    usecase \&quot;Tra cứu lịch sử điểm\&quot; as LS\n    usecase \&quot;Lấy các giao dịch điểm\\nthuộc thành viên\&quot; as GD\n    usecase \&quot;Lọc lịch sử điểm\&quot; as LOC\n    usecase \&quot;Xem chi tiết giao dịch\&quot; as CT\n}\n\nKH -- TV\nKH -- LS\n\nTV ..&gt; SD : &lt;&lt;include&gt;&gt;\nTV ..&gt; HANG : &lt;&lt;include&gt;&gt;\nTV ..&gt; TD : &lt;&lt;include&gt;&gt;\n\nLS ..&gt; GD : &lt;&lt;include&gt;&gt;\nLOC ..&gt; LS : &lt;&lt;extend&gt;&gt;\\n[Khách hàng chọn bộ lọc]\nCT ..&gt; LS : &lt;&lt;extend&gt;&gt;\\n[Khách hàng chọn giao dịch]\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="V0Rou8zcx3bDI6_z1Ps1-162">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 0 10 10;" vertex="1">
