        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC7: Biểu đồ tuần tự Sử dụng Voucher\n\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam roundcorner 0\nskinparam sequenceMessageAlign center\n\nparticipant \&quot;Khách hàng\&quot; as KH\nparticipant \&quot;Giao diện\&quot; as GD\nparticipant \&quot;Hệ thống\&quot; as HT\ndatabase \&quot;Cơ sở dữ liệu\&quot; as CSDL\n\nKH -&gt; GD : Chọn Voucher\nactivate GD\n\nGD -&gt; HT : Gửi mã Voucher\nactivate HT\n\nHT -&gt; CSDL : Kiểm tra Voucher\nactivate CSDL\nCSDL --&gt; HT : Thông tin Voucher\ndeactivate CSDL\n\nalt Voucher hợp lệ\n    HT -&gt; HT : Kiểm tra điều kiện sử dụng\n\n    alt Đủ điều kiện\n        HT -&gt; HT : Tính giá trị ưu đãi\n        HT --&gt; GD : Áp dụng Voucher thành công\n\n        KH -&gt; GD : Xác nhận mua hàng\n        GD -&gt; HT : Gửi yêu cầu đặt hàng\n\n        HT -&gt; CSDL : Tạo đơn hàng\n        activate CSDL\n        CSDL --&gt; HT : Tạo đơn hàng thành công\n        deactivate CSDL\n\n        HT -&gt; CSDL : Cập nhật trạng thái Voucher\n        activate CSDL\n        CSDL --&gt; HT : Cập nhật thành công\n        deactivate CSDL\n\n        HT --&gt; GD : Đặt hàng thành công\n\n    else Không đủ điều kiện\n        HT --&gt; GD : Không đủ điều kiện sử dụng\n    end\n\nelse Voucher không hợp lệ\n    HT --&gt; GD : Voucher không hợp lệ\nend\n\ndeactivate HT\n\nGD --&gt; KH : Hiển thị kết quả\ndeactivate GD\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiG1z5pY0S9EBoXZtEyz-1770">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
