        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam linetype polyline\nskinparam shadowing false\nskinparam defaultFontName Arial\n\nskinparam usecase {\n    BackgroundColor #DAE8FC\n    BorderColor #6C8EBF\n}\nskinparam rectangle {\n    BackgroundColor #FFFFFF\n    BorderColor #6C8EBF\n}\n\nactor \&quot;Khách hàng\&quot; as KH\n\nrectangle \&quot;CỔNG QUẢN LÝ CHƯƠNG TRÌNH\\nKHÁCH HÀNG THÂN THIẾT\&quot; {\n    usecase \&quot;Đăng ký\&quot; as DK\n    usecase \&quot;Đăng nhập\&quot; as DN\n    usecase \&quot;Tra cứu thông tin thành viên\\nvà lịch sử điểm\&quot; as UC02\n    usecase \&quot;Đổi điểm và\\nsử dụng ưu đãi\&quot; as UC03\n    usecase \&quot;Gửi và theo dõi\\nkhiếu nại\&quot; as UC04\n    usecase \&quot;Quản lý thành viên\\nvà điều chỉnh điểm\&quot; as UC05\n    usecase \&quot;Quản lý chính sách tích điểm,\\nhạng và quyền lợi\&quot; as UC06\n    usecase \&quot;Quản lý phần thưởng\\nvà ưu đãi\&quot; as UC07\n    usecase \&quot;Xử lý khiếu nại\&quot; as UC08\n\n    DK -[hidden]down- DN\n    DN -[hidden]down- UC02\n    UC02 -[hidden]down- UC03\n    UC03 -[hidden]down- UC04\n    UC04 -[hidden]down- UC05\n    UC05 -[hidden]down- UC06\n    UC06 -[hidden]down- UC07\n    UC07 -[hidden]down- UC08\n}\n\nactor \&quot;Quản trị viên\&quot; as QTV\n\nKH -- DK\nKH -- DN\nKH -- UC02\nKH -- UC03\nKH -- UC04\n\nDN -- QTV\nUC05 -- QTV\nUC06 -- QTV\nUC07 -- QTV\nUC08 -- QTV\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="V0Rou8zcx3bDI6_z1Ps1-127">
