        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC6: Biểu đồ tuần tự Đổi điểm\n\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam roundcorner 0\nskinparam sequenceMessageAlign center\n\nparticipant \&quot;Khách hàng\&quot; as KH\nparticipant \&quot;Giao diện\&quot; as GD\nparticipant \&quot;Hệ thống\&quot; as HT\ndatabase \&quot;Cơ sở dữ liệu\&quot; as CSDL\n\nKH -&gt; GD : Xem điểm thưởng\nactivate GD\n\nGD -&gt; HT : Yêu cầu xem điểm\nactivate HT\n\nHT -&gt; CSDL : Lấy điểm thưởng\nactivate CSDL\nCSDL --&gt; HT : Thông tin điểm\ndeactivate CSDL\n\nHT --&gt; GD : Hiển thị điểm thưởng\ndeactivate HT\n\nGD --&gt; KH : Hiển thị điểm\n\nKH -&gt; GD : Chọn ưu đãi\n\nGD -&gt; HT : Gửi yêu cầu đổi điểm\nactivate HT\n\nHT -&gt; CSDL : Kiểm tra số điểm\nactivate CSDL\nCSDL --&gt; HT : Kết quả kiểm tra\ndeactivate CSDL\n\nalt Đủ điểm\n    HT -&gt; CSDL : Kiểm tra ưu đãi\n    activate CSDL\n    CSDL --&gt; HT : Ưu đãi hợp lệ\n    deactivate CSDL\n\n    HT -&gt; CSDL : Trừ điểm thưởng\n    activate CSDL\n    CSDL --&gt; HT : Trừ điểm thành công\n    deactivate CSDL\n\n    HT -&gt; CSDL : Tạo Voucher\n    activate CSDL\n    CSDL --&gt; HT : Tạo Voucher thành công\n    deactivate CSDL\n\n    HT --&gt; GD : Đổi điểm thành công\n\nelse Không đủ điểm\n    HT --&gt; GD : Không đủ điểm\nend\n\ndeactivate HT\n\nGD --&gt; KH : Hiển thị kết quả\ndeactivate GD\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiG1z5pY0S9EBoXZtEyz-1730">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
