        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Admin\&quot; as AD\n\nrectangle \&quot;UC1: Đăng ký / Đăng nhập\&quot; {\n    usecase \&quot;Đăng ký tài khoản\&quot; as UC_DangKy\n    usecase \&quot;Đăng xuất\&quot; as UC_DangXuat\n    usecase \&quot;Đăng nhập\&quot; as UC_DangNhap\n    usecase \&quot;Quên mật khẩu\&quot; as UC_QuenMatKhau\n    usecase \&quot;Kiểm tra thông tin\&quot; as UC_KiemTra\n    usecase \&quot;Xác thực tài khoản\&quot; as UC_XacThuc\n}\n\n&#39; Nối các Actor với Use Case tương ứng\nKH -- UC_DangKy\nKH -- UC_DangXuat\nKH -- UC_DangNhap\nKH -- UC_QuenMatKhau\n\nNV -- UC_DangNhap\nAD -- UC_DangNhap\n\n&#39; Các mối quan hệ Include và Extend theo hình gốc\nUC_DangKy ..&gt; UC_KiemTra : &lt;&lt;include&gt;&gt;\nUC_KiemTra ..&gt; UC_DangNhap : &lt;&lt;extend&gt;&gt;\nUC_DangNhap ..&gt; UC_XacThuc : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiG1z5pY0S9EBoXZtEyz-247">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
