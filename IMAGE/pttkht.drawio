        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!pragma layout smetana\ntop to bottom direction\nhide circle\n\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam nodesep 70\nskinparam ranksep 85\n\ntitle SƠ ĐỒ LỚP PHÂN TÍCH – CHƯƠNG TRÌNH KHÁCH HÀNG THÂN THIẾT\n\nclass TaiKhoan {\n  id: UUID\n  email: String\n  password_hash: String\n  full_name: String?\n  phone: String?\n  status: String\n  --\n  dangNhap(): Boolean\n  capNhatThongTin(): void\n}\n\nclass ThanhVien {\n  user_id: UUID\n  balance: Integer\n  qualifying_spend: Decimal\n  tier_code: String\n  cycle_started_at: DateTime\n  joined_at: DateTime\n  --\n  xemThongTin(): void\n  xacDinhHang(): String\n}\n\nclass PhienBanQuyTac {\n  id: Long\n  name: String\n  status: String\n  config: String\n  effective_at: DateTime?\n  created_by: UUID?\n  published_by: UUID?\n  created_at: DateTime\n  published_at: DateTime?\n  --\n  taoBanNhap(): void\n  kiemTraHopLe(): Boolean\n  apDungPhienBan(): void\n}\n\nclass GiaoDichDiem {\n  id: Long\n  member_id: UUID\n  kind: String\n  points: Integer\n  qualifying_amount: Decimal\n  source_key: String\n  order_id: Long?\n  rule_version_id: Long?\n  description: String\n  created_at: DateTime\n  --\n  ghiNhanGiaoDich(): void\n  kiemTraTrungLap(): Boolean\n}\n\nclass KhoanDiem {\n  id: Long\n  transaction_id: Long\n  member_id: UUID\n  remaining: Integer\n  expires_at: DateTime\n  --\n  kiemTraHetHan(): Boolean\n  suDungDiem(): void\n}\n\nclass PhanThuong {\n  id: Long\n  name: String\n  description: String?\n  points_cost: Integer\n  discount_value: Decimal\n  min_order_value: Decimal\n  minimum_tier_spend: Decimal\n  stock: Integer\n  voucher_days: Integer\n  active: Boolean\n  created_by: UUID\n  created_at: DateTime\n  --\n  capNhatPhanThuong(): void\n  kiemTraDieuKienDoi(): Boolean\n}\n\nclass LuotDoiThuong {\n  id: Long\n  member_id: UUID\n  reward_id: Long\n  coupon_id: Long\n  coupon_code: String\n  points_spent: Integer\n  request_key: UUID\n  expires_at: DateTime\n  created_at: DateTime\n  --\n  doiThuong(): void\n  kiemTraYeuCauTrung(): Boolean\n}\n\nclass PhieuUuDai {\n  id: Long\n  code: String\n  name: String\n  discount_type: String\n  discount_value: Decimal\n  min_order_value: Decimal\n  usage_limit: Integer?\n  used_count: Integer\n  start_at: DateTime\n  end_at: DateTime\n  status: String\n  loyalty_owner_id: UUID?\n  --\n  kiemTraHieuLuc(): Boolean\n  kiemTraDieuKienApDung(): Boolean\n}\n\nclass LuotSuDungUuDai {\n  order_id: Long\n  coupon_id: Long\n  buyer_id: UUID\n  coupon_code: String\n  discount_amount: Decimal\n  created_at: DateTime\n  --\n  ghiNhanSuDung(): void\n}\n\nclass DieuChinhDiem {\n  id: Long\n  member_id: UUID\n  complaint_id: Long?\n  points: Integer\n  reason: String\n  status: String\n  requested_by: UUID\n  decided_by: UUID?\n  decision_note: String?\n  created_at: DateTime\n  decided_at: DateTime?\n  --\n  kiemTraHopLe(): Boolean\n  apDungDieuChinh(): void\n}\n\nclass KhieuNai {\n  id: Long\n  member_id: UUID\n  order_id: Long?\n  type: String\n  message: String\n  status: String\n  response: String?\n  handled_by: UUID?\n  created_at: DateTime\n  updated_at: DateTime\n  --\n  guiKhieuNai(): void\n  capNhatKetQua(): void\n}\n\nclass DonHang {\n  id: Long\n  order_code: String\n  buyer_id: UUID\n  subtotal: Decimal\n  discount_amount: Decimal\n  total_amount: Decimal\n  status: String\n  payment_status: String\n  created_at: DateTime\n  --\n  kiemTraDieuKienTichDiem(): Boolean\n}\n\nclass NhatKyHoatDong {\n  id: Long\n  user_id: UUID?\n  action: String\n  entity_type: String\n  entity_id: Long?\n  old_data: String?\n  new_data: String?\n  created_at: DateTime\n  --\n  ghiNhan(): void\n  traCuu(): void\n}\n\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; ThanhVien\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang\nThanhVien \&quot;1\&quot; -- \&quot;0..*\&quot; GiaoDichDiem\nGiaoDichDiem \&quot;1\&quot; -- \&quot;0..1\&quot; KhoanDiem\nThanhVien \&quot;1\&quot; .. \&quot;0..*\&quot; KhoanDiem\nPhienBanQuyTac \&quot;0..1\&quot; -- \&quot;0..*\&quot; GiaoDichDiem\nDonHang \&quot;0..1\&quot; .. \&quot;0..*\&quot; GiaoDichDiem\nThanhVien \&quot;1\&quot; -- \&quot;0..*\&quot; LuotDoiThuong\nPhanThuong \&quot;1\&quot; -- \&quot;0..*\&quot; LuotDoiThuong\nLuotDoiThuong \&quot;0..1\&quot; .. \&quot;1\&quot; PhieuUuDai\nTaiKhoan \&quot;0..1\&quot; .. \&quot;0..*\&quot; PhieuUuDai\nPhieuUuDai \&quot;1\&quot; .. \&quot;0..*\&quot; LuotSuDungUuDai\nDonHang \&quot;1\&quot; .. \&quot;0..1\&quot; LuotSuDungUuDai\nTaiKhoan \&quot;1\&quot; .. \&quot;0..*\&quot; LuotSuDungUuDai\nThanhVien \&quot;1\&quot; -- \&quot;0..*\&quot; KhieuNai\nDonHang \&quot;0..1\&quot; .. \&quot;0..*\&quot; KhieuNai\nThanhVien \&quot;1\&quot; -- \&quot;0..*\&quot; DieuChinhDiem\nKhieuNai \&quot;0..1\&quot; -- \&quot;0..*\&quot; DieuChinhDiem\nTaiKhoan \&quot;0..1\&quot; -- \&quot;0..*\&quot; NhatKyHoatDong\n\nnote bottom of PhienBanQuyTac\n  config lưu quy tắc tích điểm, thời hạn điểm,\n  chu kỳ xét hạng, các hạng và quyền lợi.\nend note\n\nnote bottom of TaiKhoan\n  Vai trò quản trị viên/khách hàng được quản lý\n  qua roles và user_roles, không tách lớp Admin.\n  Liên kết người tạo/xử lý được ghi trong\n  created_by, published_by, requested_by,\n  decided_by và handled_by ở các lớp liên quan.\nend note\n\nlegend bottom\n  ? : thuộc tính có thể rỗng. Long : SQL bigint; UUID : uniqueidentifier.\n  Nét liền: quan hệ khai báo trong Prisma; nét đứt: tham chiếu nghiệp vụ.\n  Thuộc tính bám schema; phương thức mô tả trách nhiệm ở mức phân tích.\n  Các lớp dùng chung chỉ hiển thị thuộc tính liên quan đến KHTT.\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="V0Rou8zcx3bDI6_z1Ps1-736">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
