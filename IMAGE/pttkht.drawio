        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC3: Biểu đồ tuần tự Tích điểm\n\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam roundcorner 0\nskinparam sequenceMessageAlign center\n\nparticipant \&quot;Khách hàng\&quot; as KH\nparticipant \&quot;Giao diện\&quot; as GD\nparticipant \&quot;Hệ thống\&quot; as HT\ndatabase \&quot;Cơ sở dữ liệu\&quot; as CSDL\n\nKH -&gt; GD : Mua hàng\nactivate GD\n\nGD -&gt; HT : Gửi thông tin đơn hàng\nactivate HT\n\nHT -&gt; CSDL : Tạo đơn hàng\nactivate CSDL\nCSDL --&gt; HT : Tạo đơn hàng thành công\ndeactivate CSDL\n\nHT --&gt; GD : Xác nhận tạo đơn hàng\ndeactivate HT\n\nKH -&gt; GD : Thanh toán\n\nGD -&gt; HT : Gửi thông tin thanh toán\nactivate HT\n\nHT -&gt; CSDL : Kiểm tra giao dịch\nactivate CSDL\nCSDL --&gt; HT : Kết quả giao dịch\ndeactivate CSDL\n\nalt Thanh toán thành công\n    HT -&gt; HT : Tính điểm thưởng\n\n    HT -&gt; CSDL : Cập nhật điểm thưởng\n    activate CSDL\n    CSDL --&gt; HT : Cập nhật điểm thành công\n    deactivate CSDL\n\n    HT -&gt; CSDL : Lưu lịch sử điểm\n    activate CSDL\n    CSDL --&gt; HT : Lưu thành công\n    deactivate CSDL\n\n    HT --&gt; GD : Tích điểm thành công\n\nelse Thanh toán thất bại\n    HT --&gt; GD : Thanh toán thất bại\nend\n\ndeactivate HT\n\nGD --&gt; KH : Hiển thị kết quả\ndeactivate GD\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kiG1z5pY0S9EBoXZtEyz-1692">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
