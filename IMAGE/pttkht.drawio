        <UserObject label="Tích điểm và cập nhật hạng thành viên" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="Tích điểm và cập nhật hạng thành viên" id="VbHyYETtyQtT7RWVlfbA-208">
