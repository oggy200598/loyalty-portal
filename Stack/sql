-- ==========================================================================
-- E-COMMERCE + BUYER RISK SCORING SYSTEM
-- PostgreSQL optimized schema
-- ==========================================================================

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ==========================================================================
-- 0. ENUM TYPES (thay cho VARCHAR tự do -> tránh giá trị rác, giúp CHECK
--    được thực thi ở tầng DB thay vì chỉ ở tầng application)
-- ==========================================================================

CREATE TYPE user_status        AS ENUM ('ACTIVE', 'SUSPENDED', 'DELETED');
CREATE TYPE shop_status        AS ENUM ('ACTIVE', 'SUSPENDED', 'CLOSED');
CREATE TYPE category_status    AS ENUM ('ACTIVE', 'INACTIVE');
CREATE TYPE product_status     AS ENUM ('ACTIVE', 'OUT_OF_STOCK', 'HIDDEN', 'DELETED');

CREATE TYPE order_status AS ENUM (
    'PENDING', 'CONFIRMED', 'PROCESSING', 'SHIPPING',
    'DELIVERED', 'COMPLETED',
    'CANCELLED', 'RETURNED', 'FAILED', 'NON_RECEIVED'
);
CREATE TYPE payment_status AS ENUM (
    'UNPAID', 'PAID', 'PARTIALLY_REFUNDED', 'REFUNDED', 'FAILED'
);
CREATE TYPE payment_method AS ENUM ('COD', 'BANK_TRANSFER', 'CREDIT_CARD', 'E_WALLET');
CREATE TYPE shipment_status AS ENUM (
    'PENDING', 'PICKED_UP', 'IN_TRANSIT', 'DELIVERED', 'FAILED_DELIVERY', 'RETURNED_TO_SHOP'
);
CREATE TYPE return_status AS ENUM ('REQUESTED', 'APPROVED', 'REJECTED', 'COMPLETED');

CREATE TYPE risk_level AS ENUM ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL');
CREATE TYPE impact_direction AS ENUM ('POSITIVE', 'NEGATIVE', 'NEUTRAL');
CREATE TYPE recommendation_action_type AS ENUM (
    'REQUIRE_PREPAYMENT', 'FLAG_FOR_REVIEW', 'LIMIT_COD',
    'BLOCK_BUYER', 'SEND_WARNING', 'NO_ACTION'
);
CREATE TYPE seller_decision AS ENUM (
    'IGNORED', 'CANCELLED', 'REQUIRE_PREPAYMENT', 'BLOCKED_BUYER', 'CONTACTED_BUYER'
);
CREATE TYPE notification_type AS ENUM (
    'ORDER_UPDATE', 'RISK_ALERT', 'PROMOTION', 'SYSTEM'
);
CREATE TYPE training_run_status AS ENUM ('RUNNING', 'SUCCESS', 'FAILED');

-- ==========================================================================
-- 1. USER & AUTHENTICATION
-- ==========================================================================

CREATE TABLE users (
    id            UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email         VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    full_name     VARCHAR(255),
    phone         VARCHAR(20),
    avatar_url    TEXT,
    status        user_status NOT NULL DEFAULT 'ACTIVE',
    created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE roles (
    id   BIGSERIAL PRIMARY KEY,
    name VARCHAR(50) UNIQUE NOT NULL
);

CREATE TABLE user_roles (
    user_id UUID   NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    role_id BIGINT NOT NULL REFERENCES roles(id) ON DELETE CASCADE,
    PRIMARY KEY (user_id, role_id)
);

CREATE TABLE addresses (
    id             BIGSERIAL PRIMARY KEY,
    user_id        UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    receiver_name  VARCHAR(255) NOT NULL,
    phone          VARCHAR(20) NOT NULL,
    province       VARCHAR(100) NOT NULL,
    district       VARCHAR(100) NOT NULL,
    ward           VARCHAR(100) NOT NULL,
    address_detail TEXT NOT NULL,
    is_default     BOOLEAN NOT NULL DEFAULT FALSE,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_addresses_user_id ON addresses(user_id);
-- Đảm bảo mỗi user chỉ có đúng 1 địa chỉ mặc định
CREATE UNIQUE INDEX uq_addresses_one_default_per_user
    ON addresses(user_id) WHERE is_default = TRUE;

-- ==========================================================================
-- 2. SHOP / SELLER
-- ==========================================================================

CREATE TABLE shops (
    id          BIGSERIAL PRIMARY KEY,
    owner_id    UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    name        VARCHAR(255) NOT NULL,
    description TEXT,
    logo_url    TEXT,
    status      shop_status NOT NULL DEFAULT 'ACTIVE',
    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_shops_owner_id ON shops(owner_id);

CREATE TABLE shop_members (
    shop_id    BIGINT NOT NULL REFERENCES shops(id) ON DELETE CASCADE,
    user_id    UUID   NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    role       VARCHAR(50) NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    PRIMARY KEY (shop_id, user_id)
);
CREATE INDEX idx_shop_members_user_id ON shop_members(user_id);

-- ==========================================================================
-- 3. PRODUCT
-- ==========================================================================

CREATE TABLE categories (
    id          BIGSERIAL PRIMARY KEY,
    parent_id   BIGINT REFERENCES categories(id) ON DELETE SET NULL,
    name        VARCHAR(255) NOT NULL,
    description TEXT,
    status      category_status NOT NULL DEFAULT 'ACTIVE'
);
CREATE INDEX idx_categories_parent_id ON categories(parent_id);

CREATE TABLE products (
    id              BIGSERIAL PRIMARY KEY,
    shop_id         BIGINT NOT NULL REFERENCES shops(id) ON DELETE CASCADE,
    category_id     BIGINT REFERENCES categories(id) ON DELETE SET NULL,
    name            VARCHAR(255) NOT NULL,
    description     TEXT,
    price           DECIMAL(15,2) NOT NULL CHECK (price >= 0),
    stock_quantity  INTEGER NOT NULL DEFAULT 0 CHECK (stock_quantity >= 0),
    status          product_status NOT NULL DEFAULT 'ACTIVE',
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_products_shop_id ON products(shop_id);
CREATE INDEX idx_products_category_id ON products(category_id);

CREATE TABLE product_images (
    id         BIGSERIAL PRIMARY KEY,
    product_id BIGINT NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    image_url  TEXT NOT NULL,
    is_primary BOOLEAN NOT NULL DEFAULT FALSE
);
CREATE INDEX idx_product_images_product_id ON product_images(product_id);
CREATE UNIQUE INDEX uq_product_images_one_primary
    ON product_images(product_id) WHERE is_primary = TRUE;

CREATE TABLE product_variants (
    id              BIGSERIAL PRIMARY KEY,
    product_id      BIGINT NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    variant_name    VARCHAR(255) NOT NULL,
    price           DECIMAL(15,2) NOT NULL CHECK (price >= 0),
    stock_quantity  INTEGER NOT NULL DEFAULT 0 CHECK (stock_quantity >= 0)
);
CREATE INDEX idx_product_variants_product_id ON product_variants(product_id);

-- ==========================================================================
-- 4. SHOPPING
-- ==========================================================================

CREATE TABLE carts (
    id         BIGSERIAL PRIMARY KEY,
    user_id    UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_carts_user_id ON carts(user_id); -- mỗi user 1 cart active

CREATE TABLE cart_items (
    id         BIGSERIAL PRIMARY KEY,
    cart_id    BIGINT NOT NULL REFERENCES carts(id) ON DELETE CASCADE,
    product_id BIGINT NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    variant_id BIGINT REFERENCES product_variants(id) ON DELETE SET NULL,
    quantity   INTEGER NOT NULL DEFAULT 1 CHECK (quantity > 0),
    price      DECIMAL(15,2) NOT NULL CHECK (price >= 0)
);
CREATE INDEX idx_cart_items_cart_id ON cart_items(cart_id);
CREATE INDEX idx_cart_items_product_id ON cart_items(product_id);

CREATE TABLE wishlists (
    id         BIGSERIAL PRIMARY KEY,
    user_id    UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_wishlists_user_id ON wishlists(user_id);

CREATE TABLE wishlist_items (
    wishlist_id BIGINT NOT NULL REFERENCES wishlists(id) ON DELETE CASCADE,
    product_id  BIGINT NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    PRIMARY KEY (wishlist_id, product_id)
);

-- ==========================================================================
-- 5. ORDER
--    -> shipping_* được SNAPSHOT trực tiếp vào orders thay vì chỉ giữ FK,
--       để sửa/xoá address sau này không ảnh hưởng đơn hàng đã tạo.
-- ==========================================================================

CREATE TABLE orders (
    id                    BIGSERIAL PRIMARY KEY,
    order_code            VARCHAR(50) UNIQUE NOT NULL,
    buyer_id              UUID NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
    shop_id               BIGINT NOT NULL REFERENCES shops(id) ON DELETE RESTRICT,

    -- snapshot địa chỉ tại thời điểm đặt hàng (không phụ thuộc bảng addresses)
    shipping_address_id   BIGINT REFERENCES addresses(id) ON DELETE SET NULL,
    shipping_receiver_name VARCHAR(255) NOT NULL,
    shipping_phone         VARCHAR(20) NOT NULL,
    shipping_province      VARCHAR(100) NOT NULL,
    shipping_district       VARCHAR(100) NOT NULL,
    shipping_ward            VARCHAR(100) NOT NULL,
    shipping_address_detail   TEXT NOT NULL,

    subtotal          DECIMAL(15,2) NOT NULL CHECK (subtotal >= 0),
    shipping_fee       DECIMAL(15,2) NOT NULL DEFAULT 0 CHECK (shipping_fee >= 0),
    discount_amount     DECIMAL(15,2) NOT NULL DEFAULT 0 CHECK (discount_amount >= 0),
    total_amount          DECIMAL(15,2) NOT NULL CHECK (total_amount >= 0),

    status          order_status NOT NULL DEFAULT 'PENDING',
    payment_status  payment_status NOT NULL DEFAULT 'UNPAID',

    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_orders_buyer_id ON orders(buyer_id);
CREATE INDEX idx_orders_shop_id ON orders(shop_id);
CREATE INDEX idx_orders_status ON orders(status);
-- Tối ưu cho query "đơn của buyer X trong 7/30 ngày gần nhất"
CREATE INDEX idx_orders_buyer_created ON orders(buyer_id, created_at DESC);

CREATE TABLE order_items (
    id           BIGSERIAL PRIMARY KEY,
    order_id     BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    product_id   BIGINT NOT NULL REFERENCES products(id) ON DELETE RESTRICT,
    variant_id   BIGINT REFERENCES product_variants(id) ON DELETE SET NULL,
    product_name VARCHAR(255) NOT NULL,
    quantity     INTEGER NOT NULL CHECK (quantity > 0),
    unit_price   DECIMAL(15,2) NOT NULL CHECK (unit_price >= 0),
    subtotal     DECIMAL(15,2) NOT NULL CHECK (subtotal >= 0)
);
CREATE INDEX idx_order_items_order_id ON order_items(order_id);
CREATE INDEX idx_order_items_product_id ON order_items(product_id);

CREATE TABLE order_status_history (
    id          BIGSERIAL PRIMARY KEY,
    order_id    BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    old_status  order_status,
    new_status  order_status NOT NULL,
    changed_by  UUID REFERENCES users(id) ON DELETE SET NULL,
    created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_order_status_history_order_id ON order_status_history(order_id);

-- ==========================================================================
-- 6. PAYMENT / SHIPPING
-- ==========================================================================

CREATE TABLE payments (
    id               BIGSERIAL PRIMARY KEY,
    order_id         BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    method           payment_method NOT NULL,
    amount           DECIMAL(15,2) NOT NULL CHECK (amount >= 0),
    status           payment_status NOT NULL DEFAULT 'UNPAID',
    transaction_code VARCHAR(100),
    paid_at          TIMESTAMPTZ
);
CREATE INDEX idx_payments_order_id ON payments(order_id);

CREATE TABLE shipments (
    id            BIGSERIAL PRIMARY KEY,
    order_id      BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    carrier       VARCHAR(100) NOT NULL,
    tracking_code VARCHAR(100),
    status        shipment_status NOT NULL DEFAULT 'PENDING',
    shipped_at    TIMESTAMPTZ,
    delivered_at  TIMESTAMPTZ
);
CREATE INDEX idx_shipments_order_id ON shipments(order_id);

-- ==========================================================================
-- 7. RETURN / CANCEL
-- ==========================================================================

CREATE TABLE returns (
    id            BIGSERIAL PRIMARY KEY,
    order_id      BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    reason        TEXT NOT NULL,
    status        return_status NOT NULL DEFAULT 'REQUESTED',
    requested_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    processed_at  TIMESTAMPTZ
);
CREATE INDEX idx_returns_order_id ON returns(order_id);

-- ==========================================================================
-- 8. BUYER PROFILE (trạng thái HIỆN TẠI, cập nhật realtime, dùng cho UI)
--    Khác buyer_features: đây KHÔNG phải bảng phục vụ ML, chỉ 1 dòng/buyer
--    và luôn phản ánh số liệu mới nhất.
-- ==========================================================================

CREATE TABLE buyer_profiles (
    id                   BIGSERIAL PRIMARY KEY,
    buyer_id             UUID UNIQUE NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    total_orders         INTEGER NOT NULL DEFAULT 0,
    completed_orders     INTEGER NOT NULL DEFAULT 0,
    cancelled_orders     INTEGER NOT NULL DEFAULT 0,
    returned_orders      INTEGER NOT NULL DEFAULT 0,
    failed_orders        INTEGER NOT NULL DEFAULT 0,
    non_received_orders  INTEGER NOT NULL DEFAULT 0,
    total_spent          DECIMAL(15,2) NOT NULL DEFAULT 0,
    average_order_value  DECIMAL(15,2) NOT NULL DEFAULT 0,
    first_order_at       TIMESTAMPTZ,
    last_order_at        TIMESTAMPTZ,
    updated_at           TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ==========================================================================
-- 9. ML FEATURE STORE (snapshot THEO NGÀY, dùng để train/serve model)
--    Chỉ giữ số liệu thô cần thiết + rate/trend đã tính sẵn. Không lặp lại
--    toàn bộ cột của buyer_profiles.
-- ==========================================================================

CREATE TABLE buyer_features (
    id                    BIGSERIAL PRIMARY KEY,
    buyer_id              UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    feature_date          DATE NOT NULL,

    cancel_rate           DECIMAL(8,5) NOT NULL DEFAULT 0,
    return_rate           DECIMAL(8,5) NOT NULL DEFAULT 0,
    failure_rate          DECIMAL(8,5) NOT NULL DEFAULT 0,
    non_receive_rate      DECIMAL(8,5) NOT NULL DEFAULT 0,

    total_order_value     DECIMAL(15,2) NOT NULL DEFAULT 0,
    average_order_value   DECIMAL(15,2) NOT NULL DEFAULT 0,

    orders_last_7_days    INTEGER NOT NULL DEFAULT 0,
    orders_last_30_days   INTEGER NOT NULL DEFAULT 0,
    avg_order_interval    DECIMAL(10,2) NOT NULL DEFAULT 0,

    created_at            TIMESTAMPTZ NOT NULL DEFAULT now(),

    UNIQUE (buyer_id, feature_date)   -- 1 snapshot/buyer/ngày
);
CREATE INDEX idx_buyer_features_buyer_date ON buyer_features(buyer_id, feature_date DESC);

-- ==========================================================================
-- 10. ML MODEL
-- ==========================================================================

CREATE TABLE ml_models (
    id              BIGSERIAL PRIMARY KEY,
    model_name      VARCHAR(100) NOT NULL,
    algorithm       VARCHAR(100) NOT NULL,
    version         VARCHAR(50) NOT NULL,
    accuracy        DECIMAL(8,5),
    precision_score DECIMAL(8,5),
    recall_score    DECIMAL(8,5),
    f1_score        DECIMAL(8,5),
    roc_auc         DECIMAL(8,5),
    model_path      TEXT,
    is_active       BOOLEAN NOT NULL DEFAULT FALSE,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),

    UNIQUE (model_name, version)
);
-- Chỉ 1 model active tại 1 thời điểm (giả định mỗi model_name có 1 active)
CREATE UNIQUE INDEX uq_ml_models_active_per_name
    ON ml_models(model_name) WHERE is_active = TRUE;

CREATE TABLE ml_training_runs (
    id                BIGSERIAL PRIMARY KEY,
    model_id          BIGINT NOT NULL REFERENCES ml_models(id) ON DELETE CASCADE,
    dataset_version    VARCHAR(100),
    -- Traceability: dataset train được lấy từ khoảng feature_date nào
    feature_date_from DATE,
    feature_date_to   DATE,
    training_samples  INTEGER,
    testing_samples   INTEGER,
    started_at        TIMESTAMPTZ,
    completed_at      TIMESTAMPTZ,
    status            training_run_status NOT NULL DEFAULT 'RUNNING'
);
CREATE INDEX idx_ml_training_runs_model_id ON ml_training_runs(model_id);

-- ==========================================================================
-- 11. RISK PREDICTION
-- ==========================================================================

CREATE TABLE risk_predictions (
    id                BIGSERIAL PRIMARY KEY,
    buyer_id          UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    order_id          BIGINT REFERENCES orders(id) ON DELETE SET NULL,
    model_id          BIGINT NOT NULL REFERENCES ml_models(id) ON DELETE RESTRICT,
    risk_probability  DECIMAL(8,5) NOT NULL CHECK (risk_probability BETWEEN 0 AND 1),
    risk_score        DECIMAL(5,2) NOT NULL CHECK (risk_score BETWEEN 0 AND 100),
    risk_level        risk_level NOT NULL,
    predicted_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);
-- Tối ưu cho: "lấy điểm rủi ro mới nhất của buyer X" / vẽ trend theo thời gian
CREATE INDEX idx_risk_predictions_buyer_time ON risk_predictions(buyer_id, predicted_at DESC);
CREATE INDEX idx_risk_predictions_order_id ON risk_predictions(order_id);

-- ==========================================================================
-- 12. RISK EXPLANATION
-- ==========================================================================

CREATE TABLE risk_explanations (
    id               BIGSERIAL PRIMARY KEY,
    prediction_id    BIGINT NOT NULL REFERENCES risk_predictions(id) ON DELETE CASCADE,
    feature_name     VARCHAR(100) NOT NULL,
    feature_value    DECIMAL(15,5),
    impact_value     DECIMAL(15,5),
    impact_direction impact_direction,
    description      TEXT
);
CREATE INDEX idx_risk_explanations_prediction_id ON risk_explanations(prediction_id);

-- ==========================================================================
-- 13. RECOMMENDATION + LỊCH SỬ HÀNH ĐỘNG CỦA SELLER
--     recommendations: khuyến nghị hệ thống sinh ra (immutable)
--     recommendation_actions: seller có thể đổi quyết định nhiều lần -> log
-- ==========================================================================

CREATE TABLE recommendations (
    id            BIGSERIAL PRIMARY KEY,
    prediction_id BIGINT NOT NULL REFERENCES risk_predictions(id) ON DELETE CASCADE,
    action_type   recommendation_action_type NOT NULL,
    title         VARCHAR(255) NOT NULL,
    description   TEXT,
    created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_recommendations_prediction_id ON recommendations(prediction_id);

CREATE TABLE recommendation_actions (
    id                BIGSERIAL PRIMARY KEY,
    recommendation_id BIGINT NOT NULL REFERENCES recommendations(id) ON DELETE CASCADE,
    seller_id         UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    decision          seller_decision NOT NULL,
    note              TEXT,
    created_at        TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_recommendation_actions_rec_id ON recommendation_actions(recommendation_id);

-- View tiện lợi: quyết định GẦN NHẤT của seller cho mỗi recommendation
CREATE VIEW recommendation_latest_action AS
SELECT DISTINCT ON (recommendation_id)
    recommendation_id, seller_id, decision, note, created_at
FROM recommendation_actions
ORDER BY recommendation_id, created_at DESC;

-- ==========================================================================
-- 14. REVIEW
-- ==========================================================================

CREATE TABLE reviews (
    id         BIGSERIAL PRIMARY KEY,
    order_id   BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    product_id BIGINT NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    buyer_id   UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    rating     INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),
    comment    TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),

    UNIQUE (order_id, product_id, buyer_id) -- tránh review trùng cho cùng đơn/sp
);
CREATE INDEX idx_reviews_product_id ON reviews(product_id);
CREATE INDEX idx_reviews_buyer_id ON reviews(buyer_id);

-- ==========================================================================
-- 15. NOTIFICATION (traceable: biết notification sinh ra từ prediction/
--      recommendation nào để đo hiệu quả cảnh báo)
-- ==========================================================================

CREATE TABLE notifications (
    id             BIGSERIAL PRIMARY KEY,
    user_id        UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    title          VARCHAR(255) NOT NULL,
    message        TEXT NOT NULL,
    type           notification_type NOT NULL,
    reference_type VARCHAR(50),   -- vd: 'risk_prediction', 'recommendation', 'order'
    reference_id   BIGINT,        -- id tương ứng trong bảng reference_type
    is_read        BOOLEAN NOT NULL DEFAULT FALSE,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_notifications_user_unread
    ON notifications(user_id, created_at DESC) WHERE is_read = FALSE;
CREATE INDEX idx_notifications_reference ON notifications(reference_type, reference_id);

-- ==========================================================================
-- 16. AUDIT LOG
-- ==========================================================================

CREATE TABLE audit_logs (
    id          BIGSERIAL PRIMARY KEY,
    user_id     UUID REFERENCES users(id) ON DELETE SET NULL,
    action      VARCHAR(100) NOT NULL,
    entity_type VARCHAR(100) NOT NULL,
    entity_id   BIGINT,
    old_data    JSONB,
    new_data    JSONB,
    created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX idx_audit_logs_entity ON audit_logs(entity_type, entity_id);
CREATE INDEX idx_audit_logs_user_id ON audit_logs(user_id);

-- ==========================================================================
-- 17. TRIGGERS: tự động cập nhật updated_at (tránh phải nhớ set thủ công
--     ở tầng application, chuẩn hoá behavior cho mọi bảng có updated_at)
-- ==========================================================================

CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_users_updated_at
    BEFORE UPDATE ON users
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_shops_updated_at
    BEFORE UPDATE ON shops
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_products_updated_at
    BEFORE UPDATE ON products
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_carts_updated_at
    BEFORE UPDATE ON carts
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_orders_updated_at
    BEFORE UPDATE ON orders
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- Tự động ghi order_status_history mỗi khi orders.status đổi
-- (đảm bảo lịch sử luôn đầy đủ, không phụ thuộc application nhớ insert)
CREATE OR REPLACE FUNCTION log_order_status_change()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.status IS DISTINCT FROM OLD.status THEN
        INSERT INTO order_status_history (order_id, old_status, new_status)
        VALUES (NEW.id, OLD.status, NEW.status);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_orders_status_history
    AFTER UPDATE OF status ON orders
    FOR EACH ROW EXECUTE FUNCTION log_order_status_change();