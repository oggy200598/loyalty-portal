DATABASE_URL=sqlserver://localhost\SQLEXPRESS;database=ecommerce_risk_sqlserver;integratedSecurity=true;trustServerCertificate=true;encrypt=true
# Local Windows Authentication (matches SSMS on this machine).
SQLSERVER_AUTH=windows
SQLSERVER_SERVER=.\SQLEXPRESS
SQLSERVER_DATABASE=ecommerce_risk_sqlserver
# For SQL Authentication/Docker: SQLSERVER_AUTH=sql and set the fields below.
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TRUST_CERTIFICATE=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=

# Optional cache; leave empty to read rewards directly from SQL Server.
REDIS_URL=
LOYALTY_WORKER_ENABLED=true

# Leave empty until a sandbox merchant account is available. Never commit secrets.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay/return
WEB_PUBLIC_URL=http://localhost:5173

# MoMo sandbox: use your own merchant credentials. IPN must be public HTTPS.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:3000/payments/momo/return
MOMO_IPN_URL=

# Development writes private recovery emails to .local/mail-outbox.
# Production: MAIL_TRANSPORT=resend, verified MAIL_FROM, RESEND_API_KEY and HTTPS WEB_PUBLIC_URL.
MAIL_TRANSPORT=file
MAIL_FROM=
RESEND_API_KEY=
MAIL_WORKER_ENABLED=true
